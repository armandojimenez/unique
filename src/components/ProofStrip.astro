---
import { landing } from '../i18n/index.mjs';
import { RATING } from '../config.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);
---

<section class="proof" aria-label={s.a11y.ratings}>
  <div class="container row">
    <div class="item">
      <div class="stars" aria-hidden="true">
        {[1, 2, 3, 4, 5].map(() => (
          <svg width="16" height="16" viewBox="0 0 24 24">
            <path d="M12 2.5 14.6 8l6 .7-4.5 4 1.3 5.9L12 15.7 6.6 18.6 7.9 12.7l-4.5-4 6-.7z"></path>
          </svg>
        ))}
      </div>
      <strong>{RATING.ios}</strong>
      <span>{s.proof.ratingIos}</span>
    </div>
    <i aria-hidden="true"></i>
    <div class="item">
      <strong>{RATING.android}</strong>
      <span>{s.proof.ratingAndroid}</span>
    </div>
    <i aria-hidden="true"></i>
    <div class="item">
      <strong>{s.proof.downloadsValue}</strong>
      <span>{s.proof.downloads}</span>
    </div>
  </div>
</section>

<style>
  .proof {
    padding: 27px 0;
    border-block: 1px solid rgba(59, 16, 34, 0.08);
    background: var(--blush-1);
  }

  .row,
  .item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .row {
    gap: clamp(20px, 4vw, 50px);
  }

  .item {
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .item strong {
    color: var(--ink);
    font-size: 22px;
  }

  .item span {
    color: var(--ink-soft);
    font-size: 14px;
  }

  .stars {
    display: flex;
    gap: 2px;
  }

  .stars svg {
    fill: #c3983c;
  }

  .row > i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(59, 16, 34, 0.24);
  }

  @media (max-width: 680px) {
    .row {
      flex-direction: column;
      gap: 12px;
    }

    .row > i {
      display: none;
    }
  }
</style>
