---
// The personal compliment collection and the live typing dialog.
import FeatureSection from './FeatureSection.astro';
import Phone from './Phone.astro';
import { deck, landing } from '../i18n/index.mjs';
import { sections } from '../data/localized-screens.mjs';

const { locale = 'en' } = Astro.props;
const d = deck(locale);
const s = landing(locale);
const sec = sections[locale];
const rows = d.myown.rows;
---

<FeatureSection title={d.myown.hero} body={s.sections.myown.body} flip tone="tint">
  <div class="scene" role="img" aria-label={s.sections.myown.artLabel}>
    <div class="space" aria-hidden="true">
      <div class="phone-scale">
        <Phone frame="light" status="dark">
          <div class="mo-screen">
            <div class="mo-bar">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5 8 12l6.5 7"/></svg>
              <span class="mo-title">{sec.myown.title}</span>
              <span class="mo-add">+ {sec.myown.add}</span>
            </div>
            <div class="backup">{sec.myown.backup}</div>
            <div class="mo-rows">
              {rows.map((r) => (
                <div class="mo-row">
                  <div class="row-copy">
                    <p class="mo-text">{r.text}</p>
                    {r.author && <span class="mo-author">- {r.author}</span>}
                    <span class="mo-date">{sec.myown.added}: {r.date}</span>
                  </div>
                  <div class="row-actions">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11M8 7l4-4 4 4M6 11H5a2 2 0 0 0-2 2v6h18v-6a2 2 0 0 0-2-2h-1"/></svg>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 4.2-1 10.7-10.7-3.2-3.2L5 15.8 4 20ZM14.7 6.1l3.2 3.2"/></svg>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9 7V4h6v3M7 7l1 13h8l1-13"/></svg>
                  </div>
                </div>
              ))}
            </div>
            <div class="dim"></div>
            <div class="dialog" data-myown-dialog data-text={d.myown.dialogTyped}>
              <div class="dlg-title">{sec.myown.dialogTitle}</div>
              <div class="dlg-input">
                <span data-typed>{d.myown.dialogTyped}</span><span class="caret" aria-hidden="true"></span>
              </div>
              <div class="dlg-author">{sec.myown.authorHint}</div>
              <div class="dlg-save">{sec.myown.save}</div>
            </div>
          </div>
        </Phone>
      </div>
    </div>
  </div>
</FeatureSection>

<style>
  .scene {
    --fw: 400;
    width: calc(var(--fw) * 1px);
    height: calc(var(--fw) * 1.62px);
    position: relative;
  }

  .space {
    position: absolute;
    top: 0;
    left: 0;
    width: 504px;
    height: 1068px;
    transform: scale(calc(var(--fw) / 504));
    transform-origin: top left;
  }

  .phone-scale {
    transform: scale(0.46);
    transform-origin: top left;
  }

  /* ── In-screen (440pt logical space) ── */
  .mo-screen {
    position: absolute;
    inset: 0;
    background: #ffffff;
  }

  .mo-bar {
    position: absolute;
    top: 58px;
    left: 14px;
    right: 14px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mo-title {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    font-weight: 600;
    font-size: 20px;
    color: #1a1a1a;
  }

  .mo-add {
    position: relative;
    z-index: 2;
    color: #007aff;
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
  }

  .backup {
    position: absolute;
    top: 126px;
    right: 16px;
    left: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    border-radius: 16px;
    color: #fff;
    background: linear-gradient(45deg, #499e5f, #2d8645);
    box-shadow: 0 8px 22px rgba(73, 158, 95, 0.28);
    font-size: 17px;
    font-weight: 600;
  }

  .mo-rows {
    position: absolute;
    top: 192px;
    left: 0;
    right: 0;
  }

  .mo-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 112px;
    padding: 12px 12px 12px 16px;
  }

  .mo-row:nth-child(odd) {
    background: #fff2f6;
  }

  .mo-text {
    overflow: hidden;
    color: #232323;
    font-size: 15.5px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .row-copy {
    flex: 1;
    min-width: 0;
  }

  .mo-author,
  .mo-date {
    display: block;
    margin-top: 3px;
    color: #73737e;
    font-size: 11.5px;
  }

  .row-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 12px;
  }

  .row-actions svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #8c8c96;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dim {
    position: absolute;
    inset: 0;
    background: rgba(42, 11, 26, 0.46);
    z-index: 8;
  }

  /* The add dialog, popped and slightly rotated (deck parity) */
  .dialog {
    position: absolute;
    top: 230px;
    left: 26px;
    right: 26px;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 34px 80px rgba(15, 8, 35, 0.5);
    padding: 24px 24px 22px;
    transform: rotate(-3deg);
    z-index: 9;
  }

  .dlg-title {
    text-align: center;
    font-weight: 600;
    font-size: 18px;
    color: #3b1022;
  }

  .dlg-input {
    margin-top: 16px;
    min-height: 88px;
    border-radius: 8px;
    background: #f5f5f5;
    padding: 14px 16px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.45;
    color: #3b1022;
  }

  .dlg-author {
    margin-top: 10px;
    padding: 13px 14px;
    border-radius: 8px;
    color: #8a8a95;
    background: #f5f5f5;
    font-size: 14.5px;
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: #a5124a;
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .dlg-save {
    margin-top: 18px;
    height: 46px;
    border-radius: 12px;
    background: linear-gradient(180deg, #c21a5f 0%, #8b0d3d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 16px;
    color: #fff;
    box-shadow: 0 8px 22px rgba(165, 18, 74, 0.28);
  }

  @media (max-width: 1120px) {
    .scene { --fw: 350; }
  }
  @media (max-width: 470px) {
    .scene { --fw: 300; }
  }
</style>

<script>
  // The dialog types its line, rests, and starts over.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const dlg of document.querySelectorAll<HTMLElement>('[data-myown-dialog]')) {
    const target = dlg.querySelector('[data-typed]')!;
    const full = dlg.dataset.text ?? '';
    if (reduced || !full) continue; // reduced motion keeps the full line
    let pos = full.length; // server-rendered full; restart on first tick
    let timer: ReturnType<typeof setInterval> | null = null;

    const tick = () => {
      if (document.hidden) return;
      pos += 1;
      if (pos > full.length + 30) pos = 0; // ~2s rest at the full line
      target.textContent = full.slice(0, Math.min(pos, full.length));
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !timer) timer = setInterval(tick, 70);
        else if (!entry.isIntersecting && timer) {
          clearInterval(timer);
          timer = null;
        }
      },
      { threshold: 0.3 }
    );
    io.observe(dlg);
  }
</script>
