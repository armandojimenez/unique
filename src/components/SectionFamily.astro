---
import { landing } from '../i18n/index.mjs';
import { asset } from '../config.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);

const apps = [
  { icon: 'wealthy', name: 'Wealthy' },
  { icon: 'believe', name: 'Believe' },
  { icon: 'unique', name: 'Unique', main: true },
  { icon: 'motiv', name: 'Motiv' },
  { icon: 'holy', name: 'Holy' },
  { icon: 'divine', name: 'Divine' },
  { icon: 'manna', name: 'Manna' },
  { icon: 'monea', name: 'Monea' },
  { icon: 'lilia', name: 'Lilia' },
  { icon: 'askbetter', name: 'Ask Better' },
];
---

<section class="family">
  <div class="container inner">
    <div class="copy">
      <p class="eyebrow">{s.sections.family.eyebrow}</p>
      <h2>{s.sections.family.title}</h2>
      <p>{s.sections.family.body}</p>
    </div>
    <div class="icons" aria-label={s.sections.family.ariaLabel}>
      {
        apps.map((app) => (
          <figure class={app.main ? 'main' : ''}>
            <img
              src={asset(`/img/family/${app.icon}.webp`)}
              alt={app.name}
              width="78"
              height="78"
              loading="lazy"
            />
            <figcaption>{app.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .family {
    padding: clamp(70px, 10vh, 118px) 0;
    background: var(--blush-0);
  }

  .inner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(38px, 7vw, 92px);
  }

  .eyebrow {
    color: var(--raspberry);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 12px;
    color: var(--ink);
    font-size: clamp(34px, 4.4vw, 58px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .copy > p:last-child {
    max-width: 42ch;
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.7;
  }

  .icons {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 22px 16px;
  }

  figure {
    text-align: center;
  }

  figure img {
    width: 70px;
    height: 70px;
    margin-inline: auto;
    border-radius: 17px;
    object-fit: cover;
    box-shadow: 0 10px 24px rgba(59, 16, 34, 0.16);
  }

  figure.main {
    transform: translateY(-7px);
  }

  figure.main img {
    width: 82px;
    height: 82px;
    border: 3px solid #fff;
    box-shadow: 0 14px 34px rgba(165, 18, 74, 0.28);
  }

  figcaption {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 11px;
  }

  figure.main figcaption {
    color: var(--raspberry);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .copy {
      text-align: center;
    }

    .copy > p:last-child {
      margin-inline: auto;
    }
  }

  @media (max-width: 560px) {
    .icons {
      grid-template-columns: repeat(5, minmax(48px, 1fr));
      gap: 18px 8px;
    }

    figure img {
      width: 52px;
      height: 52px;
      border-radius: 13px;
    }

    figure.main img {
      width: 62px;
      height: 62px;
    }

    figcaption {
      display: none;
    }
  }
</style>
