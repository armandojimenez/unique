---
import { landing } from '../i18n/index.mjs';
import { storeUrls, asset } from '../config.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);
const stores = storeUrls(locale);
---

<section id="download" class="cta">
  <img
    class="wing wing-left"
    src={asset('/app/images/svgIcons/unique.svg')}
    alt=""
    width="500"
    height="500"
    loading="lazy"
    aria-hidden="true"
  />
  <img
    class="wing wing-right"
    src={asset('/app/images/svgIcons/unique.svg')}
    alt=""
    width="500"
    height="500"
    loading="lazy"
    aria-hidden="true"
  />
  <div class="container inner">
    <img
      class="brand-mark"
      src={asset('/app/images/svgIcons/unique.svg')}
      alt=""
      width="64"
      height="64"
      loading="lazy"
      aria-hidden="true"
    />
    <h2>{s.cta.title}</h2>
    <p>{s.cta.body}</p>
    <div class="badges">
      <a href={stores.ios} rel="noopener">
        <img
          src={asset('/img/badges/app-store-badge.svg')}
          alt={s.hero.badgeIos}
          width="189"
          height="56"
          loading="lazy"
        />
      </a>
      <a href={stores.android} rel="noopener">
        <img
          src={asset('/img/badges/google-play-badge.svg')}
          alt={s.hero.badgeAndroid}
          width="189"
          height="56"
          loading="lazy"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(80px, 11vh, 132px) 0;
    color: #fff;
    background:
      radial-gradient(circle at 50% 0%, rgba(235, 69, 130, 0.28), transparent 38%),
      linear-gradient(160deg, #421128, #1d0b15);
  }

  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .brand-mark {
    width: 58px;
    height: auto;
    margin-bottom: 20px;
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }

  h2 {
    max-width: 760px;
    font-size: clamp(38px, 5.2vw, 70px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  p {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.75);
    font-size: clamp(15px, 1.5vw, 18px);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  .badges img {
    width: auto;
    height: 56px;
  }

  .wing {
    position: absolute;
    width: 230px;
    opacity: 0.06;
    filter: brightness(0) invert(1);
  }

  .wing-left {
    bottom: -50px;
    left: -40px;
    transform: rotate(-20deg);
  }

  .wing-right {
    top: -60px;
    right: -30px;
    transform: rotate(160deg);
  }
</style>
