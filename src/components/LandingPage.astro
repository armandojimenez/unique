---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import HeroArt from './HeroArt.astro';
import ProofStrip from './ProofStrip.astro';
import SectionCards from './SectionCards.astro';
import SectionCategories from './SectionCategories.astro';
import SectionWidgets from './SectionWidgets.astro';
import SectionThemes from './SectionThemes.astro';
import SectionShare from './SectionShare.astro';
import SectionMyOwn from './SectionMyOwn.astro';
import SectionPractice from './SectionPractice.astro';
import SectionFamily from './SectionFamily.astro';
import SectionFaq from './SectionFaq.astro';
import SectionCta from './SectionCta.astro';
import QuoteBand from './QuoteBand.astro';
import ContactModal from './ContactModal.astro';
import SiteFooter from './SiteFooter.astro';
import LangBanner from './LangBanner.astro';
import { HREFLANG, landing, localeUrl, PUBLISHED_LOCALES } from '../i18n/index.mjs';
import { storeUrls, asset } from '../config.mjs';
import { mobileApp, organization, webSite, faqPage } from '../seo/schema.mjs';
import { sections } from '../data/localized-screens.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);
const sec = sections[locale] ?? sections.en;
const stores = storeUrls(locale);
const pageUrl = new URL(localeUrl(locale), Astro.site).href;
const heroLines = s.hero.title.split('\n');
const schemas = [
  mobileApp({
    description: s.meta.description,
    url: pageUrl,
    image: new URL(asset(`/og/${locale}.png`), Astro.site).href,
    screenshot: new URL(asset(`/og/screenshot-${locale}.jpg`), Astro.site).href,
  }),
  organization(),
  webSite({ url: pageUrl }),
  faqPage(s.faq.items, { url: pageUrl, language: HREFLANG[locale] }),
];
---

<Base
  locale={locale}
  title={s.meta.title}
  description={s.meta.description}
  ogAlt={s.meta.ogAlt}
  schemas={schemas}
>
  <a class="skip-link" href="#main-content">{s.a11y.skip}</a>
  <a id="top"></a>
  <SiteHeader locale={locale} />
  {PUBLISHED_LOCALES.length > 1 && <LangBanner locale={locale} />}

  <main id="main-content">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1>{heroLines.map((line) => <span>{line}</span>)}</h1>
          <img
            class="hero-butterfly"
            src={asset('/app/images/svgIcons/unique.svg')}
            alt=""
            width="58"
            height="58"
            aria-hidden="true"
          />
          <p class="lead">{s.hero.sub}</p>
          <div class="badges">
            <a href={stores.ios} rel="noopener">
              <img
                src={asset('/img/badges/app-store-badge.svg')}
                alt={s.hero.badgeIos}
                width="182"
                height="54"
              />
            </a>
            <a href={stores.android} rel="noopener">
              <img
                src={asset('/img/badges/google-play-badge.svg')}
                alt={s.hero.badgeAndroid}
                width="182"
                height="54"
              />
            </a>
          </div>
        </div>
        <div class="hero-art-col">
          <HeroArt locale={locale} />
        </div>
      </div>
    </section>

    <ProofStrip locale={locale} />

    <SectionCards locale={locale} />
    <QuoteBand text={sec.bands[0].text} tone="raspberry" />

    <SectionCategories locale={locale} />
    <SectionWidgets locale={locale} />
    <QuoteBand text={sec.bands[1].text} tone="light" />

    <SectionThemes locale={locale} />
    <SectionShare locale={locale} />
    <QuoteBand text={sec.bands[2].text} tone="night" />

    <SectionMyOwn locale={locale} />
    <SectionPractice locale={locale} />

    <SectionFamily locale={locale} />
    <SectionFaq locale={locale} />
    <QuoteBand text={sec.bands[3].text} tone="light" />

    <SectionCta locale={locale} />
  </main>

  <ContactModal locale={locale} />
  <SiteFooter locale={locale} />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 14% 16%, rgba(252, 192, 215, 0.5), transparent 30%),
      radial-gradient(circle at 88% 76%, rgba(216, 244, 232, 0.8), transparent 31%),
      linear-gradient(180deg, var(--blush-0) 0%, var(--blush-1) 100%);
  }

  .hero::after {
    position: absolute;
    right: -160px;
    bottom: -210px;
    width: 520px;
    height: 520px;
    border: 1px solid rgba(165, 18, 74, 0.08);
    border-radius: 50%;
    content: '';
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding-top: clamp(32px, 6vh, 72px);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-top: clamp(8px, 4vh, 48px);
    padding-bottom: clamp(24px, 5vh, 64px);
  }

  h1 {
    max-width: 670px;
    color: var(--ink);
    font-size: clamp(48px, 6.6vw, 86px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.04;
  }

  h1 span {
    display: block;
  }

  :global(html:not([lang='en'])) h1 {
    font-size: clamp(40px, 4.3vw, 54px);
  }

  .hero-butterfly {
    width: 50px;
    height: auto;
    margin-top: 22px;
    filter: sepia(1) saturate(5) hue-rotate(290deg);
    transform: rotate(-10deg);
  }

  .lead {
    max-width: 48ch;
    margin-top: 16px;
    color: var(--ink-soft);
    font-size: clamp(16px, 1.45vw, 19px);
    line-height: 1.7;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 34px;
  }

  .badges a {
    border-radius: 10px;
  }

  .badges img {
    width: auto;
    height: 54px;
  }

  .hero-art-col {
    z-index: 1;
    display: flex;
    align-self: end;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-copy {
      padding-bottom: 12px;
      text-align: center;
    }

    .eyebrow,
    .lead {
      margin-inline: auto;
    }

    .hero-butterfly {
      margin-inline: auto;
    }

    .badges {
      justify-content: center;
    }

    .hero-art-col {
      margin-top: 6px;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: clamp(52px, 17vw, 78px);
    }

    :global(html:not([lang='en'])) h1 {
      font-size: clamp(30px, 8.4vw, 36px);
    }

    .badges {
      flex-direction: column;
    }
  }
</style>
