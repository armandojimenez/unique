---
// Contact form in a native <dialog> (accessible, Esc closes, backdrop
// click closes). Posts to the same Formspree endpoint the old site used.
import { landing } from '../i18n/index.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);
---

<dialog id="contact-dialog" data-contact-dialog aria-labelledby="contact-title">
  <div class="head">
    <h3 id="contact-title">{s.contact.title}</h3>
    <button type="button" class="close" data-contact-close aria-label={s.a11y.close}>
      <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>
  <form action="https://formspree.io/f/xdoyzjgr" method="POST">
    <label>
      <span>{s.contact.name}</span>
      <input type="text" name="_name" autocomplete="name" required />
    </label>
    <label>
      <span>{s.contact.email}</span>
      <input type="email" name="_replyto" autocomplete="email" spellcheck="false" required />
    </label>
    <label>
      <span>{s.contact.message}</span>
      <textarea name="message" rows="5" autocomplete="off" required></textarea>
    </label>
    <button class="btn-pill" type="submit">{s.contact.send}</button>
  </form>
</dialog>

<style>
  dialog {
    border: none;
    border-radius: 24px;
    padding: 0;
    width: min(440px, calc(100vw - 40px));
    background: var(--blush-0);
    color: var(--ink);
    box-shadow: 0 40px 90px rgba(16, 10, 40, 0.35);
    overscroll-behavior: contain;
  }

  dialog::backdrop {
    background: rgba(16, 12, 40, 0.45);
    backdrop-filter: blur(4px);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 26px 0;
  }

  h3 {
    font-weight: 700;
    font-size: 20px;
  }

  .close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 6px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 26px 26px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-soft);
  }

  input,
  textarea {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid rgba(35, 37, 90, 0.16);
    border-radius: 12px;
    padding: 12px 14px;
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--teal);
    border-color: transparent;
  }

  form .btn-pill {
    justify-content: center;
    margin-top: 4px;
  }
</style>

<script>
  const dialog = document.querySelector('[data-contact-dialog]') as HTMLDialogElement | null;
  if (dialog) {
    for (const opener of document.querySelectorAll('[data-contact-open]')) {
      opener.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    }
    dialog.querySelector('[data-contact-close]')?.addEventListener('click', () => dialog.close());
    // Close on a true backdrop click only: a text-selection drag that
    // starts in the textarea and releases outside must not destroy a
    // half-typed message, so both pointerdown and click must land on the
    // dialog element itself (code review 2026-07-24).
    let downOnBackdrop = false;
    dialog.addEventListener('pointerdown', (e) => {
      downOnBackdrop = e.target === dialog;
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog && downOnBackdrop) dialog.close();
    });
  }
</script>
